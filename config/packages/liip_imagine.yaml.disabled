liip_imagine:
    resolvers:
        default:
            web_path: ~

    filter_sets:
        cache: ~

        thumb_small:
            quality: 75
            filters:
                thumbnail: { size: [100, 100], mode: outbound }

        thumb_medium:
            quality: 75
            filters:
                thumbnail: { size: [300, 300], mode: outbound }
