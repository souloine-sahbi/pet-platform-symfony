{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}Détails du message{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-envelope-open"></i> Lecture du message</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_message_index') }}">Messages</a></li>
                        <li class="breadcrumb-item active">Lecture</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-9">
                    <div class="card card-primary card-outline">
                        <div class="card-header">
                            <h3 class="card-title">Détails du message</h3>
                             <div class="card-tools">
                                <span class="badge badge-info">{{ message.dateEnvoi|date('d/m/Y H:i') }}</span>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="mailbox-read-info">
                                <h5>Sujet: <span class="badge badge-secondary">Message privé</span></h5>
                                <h6>De: {{ message.expediteur.nomComplet }}
                                    <span class="mailbox-read-time float-right">{{ message.dateEnvoi|date('d M. Y H:i') }}</span></h6>
                            </div>
                            <div class="mailbox-read-message">
                                <p>{{ message.contenu|nl2br }}</p>
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                        </div>
                        <div class="card-footer">
                            <div class="float-right">
                                <button type="button" class="btn btn-default"><i class="fas fa-reply"></i> Répondre</button>
                                <button type="button" class="btn btn-default"><i class="fas fa-share"></i> Transférer</button>
                            </div>
                            <form method="post" action="{{ path('app_message_delete', {'id': message.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce message ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.id) }}">
                                <button type="submit" class="btn btn-default"><i class="far fa-trash-alt"></i> Supprimer</button>
                            </form>
                            <a href="{{ path('app_message_index') }}" class="btn btn-default"><i class="fas fa-arrow-left"></i> Retour</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
