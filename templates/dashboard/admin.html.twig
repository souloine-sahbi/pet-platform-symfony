{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - PetNexus{% endblock %}

{% block body %}
    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <!-- Left navbar links -->
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>

        <!-- Right navbar links -->
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Sidebar Container -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <!-- Brand Logo -->
        <a href="{{ path('admin_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus Admin</span>
        </a>

        <!-- Sidebar -->
        <div class="sidebar">
            <!-- Sidebar user panel -->
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    <i class="fas fa-user-shield fa-2x text-white"></i>
                </div>
                <div class="info">
                    <a href="#" class="d-block">{{ app.user.nomComplet }}</a>
                </div>
            </div>

            <!-- Sidebar Menu -->
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link active">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_utilisateur_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Utilisateurs</p>
                        </a>
                    </li>
                    <!-- NOUVEAU : Section Animaux -->
                    <li class="nav-item">
                        <a href="{{ path('admin_animaux') }}" class="nav-link">
                            <i class="nav-icon fas fa-paw"></i>
                            <p>Animaux</p>
                        </a>
                    </li>
                    <!-- NOUVEAU : Section Annonces -->
                    <li class="nav-item">
                        <a href="{{ path('admin_annonces') }}" class="nav-link">
                            <i class="nav-icon fas fa-bullhorn"></i>
                            <p>Annonces</p>
                        </a>
                    </li>
                    <!-- NOUVEAU : Section Demandes -->
                    <li class="nav-item">
                        <a href="{{ path('admin_demandes') }}" class="nav-link">
                            <i class="nav-icon fas fa-clipboard-list"></i>
                            <p>Demandes</p>
                            {% if stats.demandes_en_attente is defined and stats.demandes_en_attente > 0 %}
                                <span class="badge badge-warning right">{{ stats.demandes_en_attente }}</span>
                            {% endif %}
                        </a>
                    </li>
                    <!-- NOUVEAU : Section Messages -->
                    <li class="nav-item">
                        <a href="{{ path('admin_messages') }}" class="nav-link">
                            <i class="nav-icon fas fa-envelope"></i>
                            <p>Messages Signalés</p>
                            {% if stats.messages_signales is defined and stats.messages_signales > 0 %}
                                <span class="badge badge-danger right">{{ stats.messages_signales }}</span>
                            {% endif %}
                        </a>
                    </li>
                    <!-- EXISTANT : Section Évaluations -->
                    <li class="nav-item">
                        <a href="{{ path('admin_evaluation_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                    <!-- NOUVEAU : Section Paramètres -->
                    <li class="nav-item">
                        <a href="{{ path('admin_parametres') }}" class="nav-link">
                            <i class="nav-icon fas fa-cogs"></i>
                            <p>Paramètres</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <!-- Content Header -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Dashboard Administrateur</h1>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <!-- Stats Row -->
                <div class="row">
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>{{ stats.total_users ?? 0 }}</h3>
                                <p>Total Utilisateurs</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <a href="{{ path('admin_utilisateur_index') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>{{ stats.total_clients ?? 0 }}</h3>
                                <p>Clients</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-user"></i>
                            </div>
                            <a href="{{ path('admin_utilisateur_index') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>{{ stats.total_admins ?? 0 }}</h3>
                                <p>Administrateurs</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-user-shield"></i>
                            </div>
                            <a href="{{ path('admin_utilisateur_index') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>{{ stats.total_evaluations ?? 0 }}</h3>
                                <p>Évaluations</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-star"></i>
                            </div>
                            <a href="{{ path('admin_evaluation_index') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Deuxième ligne de statistiques -->
                <div class="row mt-3">
                    <!-- NOUVEAU : Stat pour les demandes en attente -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-warning">
                            <div class="inner">
                                <h3>{{ stats.demandes_en_attente ?? 0 }}</h3>
                                <p>Demandes en Attente</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                            <a href="{{ path('admin_demandes') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- NOUVEAU : Stat pour les messages signalés -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-danger">
                            <div class="inner">
                                <h3>{{ stats.messages_signales ?? 0 }}</h3>
                                <p>Messages Signalés</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <a href="{{ path('admin_messages') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- NOUVEAU : Stat pour les animaux -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-info">
                            <div class="inner">
                                <h3>{{ stats.total_animaux ?? 0 }}</h3>
                                <p>Animaux</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-paw"></i>
                            </div>
                            <a href="{{ path('admin_animaux') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>

                    <!-- NOUVEAU : Stat pour les annonces -->
                    <div class="col-lg-3 col-6">
                        <div class="small-box bg-success">
                            <div class="inner">
                                <h3>{{ stats.total_annonces ?? 0 }}</h3>
                                <p>Annonces Actives</p>
                            </div>
                            <div class="icon">
                                <i class="fas fa-bullhorn"></i>
                            </div>
                            <a href="{{ path('admin_annonces') }}" class="small-box-footer">Plus d'info <i class="fas fa-arrow-circle-right"></i></a>
                        </div>
                    </div>
                </div>

                <!-- Welcome Card -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-info-circle"></i>
                                    Bienvenue, {{ app.user.nomComplet }}
                                </h3>
                            </div>
                            <div class="card-body">
                                <p>Vous êtes connecté en tant qu'<strong>Administrateur</strong>.</p>
                                <p>Cette plateforme vous permet de gérer l'ensemble de la plateforme PetNexus.</p>

                                <div class="alert alert-info">
                                    <h5><i class="icon fas fa-info"></i> Vos responsabilités :</h5>
                                    <ul>
                                        <li>Gestion des utilisateurs (Admin et Client)</li>
                                        <li>Gestion des animaux et annonces</li>
                                        <li>Modération des demandes entre utilisateurs</li>
                                        <li>Gestion des messages signalés</li>
                                        <li>Modération des évaluations</li>
                                        <li>Consultation des statistiques de la plateforme</li>
                                        <li>Surveillance de l'activité globale</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Actions Rapides</h3>
                            </div>
                            <div class="card-body">
                                <a href="{{ path('admin_utilisateur_index') }}" class="btn btn-primary mr-2 mb-2">
                                    <i class="fas fa-user-plus"></i> Gérer les utilisateurs
                                </a>
                                <a href="{{ path('admin_demandes') }}" class="btn btn-warning mr-2 mb-2">
                                    <i class="fas fa-clipboard-check"></i> Voir les demandes
                                </a>
                                <a href="{{ path('admin_messages') }}" class="btn btn-danger mr-2 mb-2">
                                    <i class="fas fa-envelope"></i> Messages signalés
                                </a>
                                <a href="{{ path('admin_animaux') }}" class="btn btn-info mr-2 mb-2">
                                    <i class="fas fa-paw"></i> Gérer les animaux
                                </a>
                                <a href="{{ path('admin_annonces') }}" class="btn btn-success mr-2 mb-2">
                                    <i class="fas fa-bullhorn"></i> Gérer les annonces
                                </a>
                                <a href="{{ path('admin_evaluation_index') }}" class="btn btn-warning mr-2 mb-2">
                                    <i class="fas fa-star"></i> Voir les évaluations
                                </a>
                                <a href="{{ path('admin_parametres') }}" class="btn btn-secondary mb-2">
                                    <i class="fas fa-cogs"></i> Paramètres
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <strong>Copyright &copy; 2024 <a href="#">PetNexus</a>.</strong>
        Tous droits réservés.
        <div class="float-right d-none d-sm-inline-block">
            <b>Version</b> 1.0.0
        </div>
    </footer>
{% endblock %}
