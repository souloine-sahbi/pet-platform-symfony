{% extends 'layout/client.html.twig' %}

{% block title %}Créer une annonce{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-bullhorn"></i> Créer une annonce</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('client_annonces') }}">Mes Annonces</a></li>
                        <li class="breadcrumb-item active">Créer</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card card-success">
                        <div class="card-header">
                            <h3 class="card-title">Nouvelle annonce</h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(form) }}
                            <div class="row">
                                <div class="col-md-8">
                                    {{ form_row(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Chat perdu, Bouledogue à adopter...'}}) }}
                                </div>
                                <div class="col-md-4">
                                    {{ form_row(form.type, {'attr': {'class': 'form-control'}}) }}
                                </div>
                            </div>

                            <div class="mt-3">
                                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Décrivez votre annonce...'}}) }}
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6">
                                    {{ form_row(form.statut, {'attr': {'class': 'form-control'}}) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_row(form.animals, {'attr': {'class': 'form-control select2-multiple'}}) }}
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Sélectionnez un ou plusieurs animaux concernés par cette annonce.
                                    </small>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-paper-plane"></i> Publier l'annonce
                                </button>
                                <a href="{{ path('client_annonces') }}" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Annuler
                                </a>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script>
        $(document).ready(function() {
            // Initialiser Select2 pour la sélection multiple
            $('.select2-multiple').select2({
                placeholder: "Sélectionnez un ou plusieurs animaux",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
{% endblock %}
