{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}{{ annonce.titre }}{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">
                        <i class="fas fa-bullhorn"></i> {{ annonce.titre }}
                        <span class="badge badge-{{ annonce.statut == 'active' ? 'success' : 'secondary' }} float-right" style="font-size: 0.5em; vertical-align: middle;">
                            {{ annonce.statut == 'active' ? 'Active' : 'Clôturée' }}
                        </span>
                    </h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Accueil</a></li>
                        <li class="breadcrumb-item active">Détail Annonce</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="card card-{{ annonce.statut == 'active' ? 'primary' : 'secondary' }} card-outline">
                        <div class="card-header">
                            <h3 class="card-title">
                                <span class="badge badge-light mr-2">{{ annonce.type|capitalize }}</span>
                                par <strong>{{ annonce.auteur.nomComplet }}</strong>
                            </h3>
                            <div class="card-tools">
                                <span class="text-muted" title="Date de publication">
                                    <i class="fas fa-calendar-alt"></i> {{ annonce.datePublication|date('d/m/Y H:i') }}
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            <h4>Description</h4>
                            <p class="lead">{{ annonce.description }}</p>

                            {% if annonce.animals|length > 0 %}
                                <div class="mt-4">
                                    <h5><i class="fas fa-paw"></i> Animaux concernés</h5>
                                    <div class="row">
                                        {% for animal in annonce.animals %}
                                            <div class="col-md-6 col-lg-4 mb-3">
                                                <div class="card h-100">
                                                    {% if animal.photo %}
                                                        <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}"
                                                             class="card-img-top"
                                                             alt="{{ animal.nom }}"
                                                             style="height: 150px; object-fit: cover;">
                                                    {% else %}
                                                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                                             style="height: 150px;">
                                                            <i class="fas fa-paw fa-3x text-muted"></i>
                                                        </div>
                                                    {% endif %}

                                                    <div class="card-body p-2">
                                                        <h6 class="card-title font-weight-bold">{{ animal.nom }}</h6>
                                                        <p class="card-text small mb-0">
                                                            {{ animal.race }}, {{ animal.age }} an(s)<br>
                                                            {{ animal.sexe == 'male' ? 'Mâle' : 'Femelle' }}
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        <div class="card-footer">
                            <div class="float-right">
                                {% if app.user and app.user != annonce.auteur and annonce.statut == 'active' %}
                                    <a href="{{ path('app_demande_new', {'annonce_id': annonce.id}) }}"
                                       class="btn btn-primary">
                                        <i class="fas fa-hand-paper"></i> Faire une demande
                                    </a>
                                {% endif %}

                                {% if app.user == annonce.auteur or is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_annonce_edit', {'id': annonce.id}) }}"
                                       class="btn btn-warning">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                {% endif %}
                            </div>
                            <a href="{{ is_granted('ROLE_ADMIN') ? path('admin_annonces') : path('client_annonces') }}" class="btn btn-default">
                                <i class="fas fa-arrow-left"></i> Retour
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-info">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-info-circle"></i> Informations</h3>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-striped">
                                <tr>
                                    <th>Auteur</th>
                                    <td>{{ annonce.auteur.nomComplet }}</td>
                                </tr>
                                <tr>
                                    <th>Email</th>
                                    <td>{{ annonce.auteur.email }}</td>
                                </tr>
                                <tr>
                                    <th>Téléphone</th>
                                    <td>{{ annonce.auteur.telephone ?? 'Non renseigné' }}</td>
                                </tr>
                                <tr>
                                    <th>Type</th>
                                    <td>{{ annonce.type|capitalize }}</td>
                                </tr>
                                <tr>
                                    <th>Statut</th>
                                    <td>
                                        <span class="badge badge-{{ annonce.statut == 'active' ? 'success' : 'secondary' }}">
                                            {{ annonce.statut == 'active' ? 'Active' : 'Clôturée' }}
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    {% if annonce.demandes|length > 0 %}
                        <div class="card card-purple">
                            <div class="card-header">
                                <h3 class="card-title">
                                    <i class="fas fa-clipboard-list"></i> Demandes
                                    <span class="badge badge-warning right">{{ annonce.demandes|length }}</span>
                                </h3>
                            </div>
                            <div class="card-body">
                                {% for demande in annonce.demandes %}
                                    <div class="callout callout-{{ demande.statut == 'en_attente' ? 'warning' : (demande.statut == 'accepte' ? 'success' : 'danger') }}">
                                        <h5>{{ demande.demandeur.nomComplet }}</h5>
                                        <p class="text-muted small mb-1">
                                            {{ demande.dateEnvoi|date('d/m/Y H:i') }}
                                        </p>
                                        <p class="font-italic mb-1">"{{ demande.message|slice(0, 80) }}..."</p>
                                        <span class="badge badge-{{ demande.statut == 'en_attente' ? 'warning' : (demande.statut == 'accepte' ? 'success' : 'danger') }}">
                                            {{ demande.statut }}
                                        </span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
