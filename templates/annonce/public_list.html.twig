{% extends 'layout/client.html.twig' %}

{% block title %}Toutes les Annonces - PetNexus{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-bullhorn"></i> Toutes les Annonces</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Annonces</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-3">
                    <form action="#" method="get">
                        <div class="input-group">
                            <input type="search" class="form-control form-control-lg" placeholder="Rechercher une annonce (race, type...)" name="q">
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-lg btn-default">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row">
                {% if annonces is empty %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Aucune annonce disponible pour le moment.
                        </div>
                    </div>
                {% else %}
                    {% for annonce in annonces %}
                        <div class="col-12 col-sm-6 col-md-4 d-flex align-items-stretch flex-column">
                            <div class="card bg-light d-flex flex-fill">
                                <div class="card-header text-muted border-bottom-0">
                                    {{ annonce.type|capitalize }}
                                </div>
                                <div class="card-body pt-0">
                                    <div class="row">
                                        <div class="col-7">
                                            <h2 class="lead"><b>{{ annonce.titre }}</b></h2>
                                            <p class="text-muted text-sm"><b>Par: </b> {{ annonce.auteur.nomComplet }} </p>
                                            <ul class="ml-4 mb-0 fa-ul text-muted">
                                                <li class="small"><span class="fa-li"><i class="fas fa-calendar-alt"></i></span> Publié le: {{ annonce.datePublication|date('d/m/Y') }}</li>
                                                {% if annonce.animals|length > 0 %}
                                                    <li class="small"><span class="fa-li"><i class="fas fa-paw"></i></span> Animal: {{ annonce.animals.first.nom }}</li>
                                                {% endif %}
                                            </ul>
                                        </div>
                                        <div class="col-5 text-center">
                                            {% if annonce.animals|length > 0 and annonce.animals.first.photo %}
                                                <img src="{{ asset('uploads/animal_images/' ~ annonce.animals.first.photo) }}" alt="Animal Photo" class="img-circle img-fluid">
                                            {% else %}
                                                <div class="img-circle img-fluid bg-secondary d-flex align-items-center justify-content-center" style="height: 80px; width: 80px; margin: 0 auto;">
                                                    <i class="fas fa-paw fa-2x"></i>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <p class="card-text">{{ annonce.description|slice(0, 100) }}...</p>
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <div class="text-right">
                                        <a href="{{ path('app_annonce_show', {'id': annonce.id}) }}" class="btn btn-sm btn-primary">
                                            <i class="fas fa-eye"></i> Voir détails
                                        </a>
                                        <a href="{{ path('app_demande_new') }}?annonce_id={{ annonce.id }}" class="btn btn-sm btn-success">
                                            <i class="fas fa-paper-plane"></i> Contacter
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
