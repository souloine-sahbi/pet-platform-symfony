{% extends 'base.html.twig' %}

{% block title %}Gestion des Évaluations{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('admin_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus Admin</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    <i class="fas fa-user-shield fa-2x text-white"></i>
                </div>
                <div class="info">
                    <a href="#" class="d-block">{{ app.user.nomComplet }}</a>
                </div>
            </div>
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_utilisateur_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Utilisateurs</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_evaluation_index') }}" class="nav-link active">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Gestion des Évaluations</h1>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                {% endfor %}

                <div class="row">
                    <div class="col-lg-6">
                        <div class="info-box bg-gradient-info">
                            <span class="info-box-icon"><i class="fas fa-star"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Total Évaluations</span>
                                <span class="info-box-number">{{ stats.total }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="info-box bg-gradient-warning">
                            <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Moyenne Générale</span>
                                <span class="info-box-number">{{ stats.moyenne|number_format(2) }} / 5</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Toutes les évaluations</h3>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered table-hover" id="evaluationsTable">
                            <thead>
                            <tr>
                                <th>ID</th>
                                <th>Évaluateur</th>
                                <th>Évalué</th>
                                <th>Note</th>
                                <th>Commentaire</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for evaluation in evaluations %}
                                <tr>
                                    <td>{{ evaluation.id }}</td>
                                    <td>
                                        <a href="{{ path('admin_utilisateur_show', {'id': evaluation.evaluateur.id}) }}">
                                            {{ evaluation.evaluateur.nomComplet }}
                                        </a>
                                    </td>
                                    <td>
                                        <a href="{{ path('admin_utilisateur_show', {'id': evaluation.evalue.id}) }}">
                                            {{ evaluation.evalue.nomComplet }}
                                        </a>
                                    </td>
                                    <td>
                                        {% for i in 1..5 %}
                                            {% if i <= evaluation.note %}
                                                <i class="fas fa-star text-warning"></i>
                                            {% else %}
                                                <i class="far fa-star text-warning"></i>
                                            {% endif %}
                                        {% endfor %}
                                        <span class="badge badge-info">{{ evaluation.note }}/5</span>
                                    </td>
                                    <td>
                                        {% if evaluation.commentaire %}
                                            {{ evaluation.commentaire|length > 50 ? evaluation.commentaire|slice(0, 50) ~ '...' : evaluation.commentaire }}
                                        {% else %}
                                            <em class="text-muted">Pas de commentaire</em>
                                        {% endif %}
                                    </td>
                                    <td>{{ evaluation.dateEvaluation|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <a href="{{ path('admin_evaluation_show', {'id': evaluation.id}) }}"
                                           class="btn btn-sm btn-info"
                                           title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <form method="post"
                                              action="{{ path('admin_evaluation_delete', {'id': evaluation.id}) }}"
                                              style="display:inline;"
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette évaluation ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center">Aucune évaluation trouvée</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap4.min.css">
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#evaluationsTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.11.5/i18n/fr-FR.json"
                },
                "order": [[0, "desc"]]
            });
        });
    </script>
{% endblock %}
