{% extends 'base.html.twig' %}

{% block title %}Détails Évaluation{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('admin_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus Admin</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_evaluation_index') }}" class="nav-link active">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Détails de l'évaluation #{{ evaluation.id }}</h1>
                    </div>
                    <div class="col-sm-6">
                        <a href="{{ path('admin_evaluation_index') }}" class="btn btn-secondary float-right">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card card-widget widget-user">
                            <div class="widget-user-header bg-info">
                                <h3 class="widget-user-username">{{ evaluation.evaluateur.nomComplet }}</h3>
                                <h5 class="widget-user-desc">Évaluateur</h5>
                            </div>
                            <div class="widget-user-image">
                                {% if evaluation.evaluateur.photoProfil %}
                                    <img class="img-circle elevation-2"
                                         src="{{ asset('uploads/photos/' ~ evaluation.evaluateur.photoProfil) }}"
                                         alt="User Avatar">
                                {% else %}
                                    <div class="img-circle elevation-2 bg-light d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                                        <i class="fas fa-user-circle fa-4x text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="card-footer">
                                <div class="description-block">
                                    <h5 class="description-header">{{ evaluation.evaluateur.email }}</h5>
                                    <span class="description-text">Email</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card card-widget widget-user">
                            <div class="widget-user-header bg-success">
                                <h3 class="widget-user-username">{{ evaluation.evalue.nomComplet }}</h3>
                                <h5 class="widget-user-desc">Évalué</h5>
                            </div>
                            <div class="widget-user-image">
                                {% if evaluation.evalue.photoProfil %}
                                    <img class="img-circle elevation-2"
                                         src="{{ asset('uploads/photos/' ~ evaluation.evalue.photoProfil) }}"
                                         alt="User Avatar">
                                {% else %}
                                    <div class="img-circle elevation-2 bg-light d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                                        <i class="fas fa-user-circle fa-4x text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="card-footer">
                                <div class="description-block">
                                    <h5 class="description-header">{{ evaluation.evalue.email }}</h5>
                                    <span class="description-text">Email</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header bg-warning">
                                <h3 class="card-title">
                                    <i class="fas fa-star"></i> Détails de l'évaluation
                                </h3>
                            </div>
                            <div class="card-body">
                                <dl class="row">
                                    <dt class="col-sm-3">Note :</dt>
                                    <dd class="col-sm-9">
                                        {% for i in 1..5 %}
                                            {% if i <= evaluation.note %}
                                                <i class="fas fa-star text-warning fa-2x"></i>
                                            {% else %}
                                                <i class="far fa-star text-warning fa-2x"></i>
                                            {% endif %}
                                        {% endfor %}
                                        <span class="badge badge-warning badge-lg ml-2">{{ evaluation.note }}/5</span>
                                    </dd>

                                    <dt class="col-sm-3">Date :</dt>
                                    <dd class="col-sm-9">{{ evaluation.dateEvaluation|date('d/m/Y à H:i') }}</dd>

                                    <dt class="col-sm-3">Commentaire :</dt>
                                    <dd class="col-sm-9">
                                        {% if evaluation.commentaire %}
                                            <div class="alert alert-light">
                                                {{ evaluation.commentaire }}
                                            </div>
                                        {% else %}
                                            <em class="text-muted">Aucun commentaire</em>
                                        {% endif %}
                                    </dd>
                                </dl>
                            </div>
                            <div class="card-footer">
                                <form method="post"
                                      action="{{ path('admin_evaluation_delete', {'id': evaluation.id}) }}"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette évaluation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fas fa-trash"></i> Supprimer cette évaluation
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
