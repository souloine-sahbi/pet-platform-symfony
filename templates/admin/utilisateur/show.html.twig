{% extends 'base.html.twig' %}

{% block title %}Détails Utilisateur{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('admin_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus Admin</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_utilisateur_index') }}" class="nav-link active">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Utilisateurs</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Détails de l'utilisateur</h1>
                    </div>
                    <div class="col-sm-6">
                        <a href="{{ path('admin_utilisateur_index') }}" class="btn btn-secondary float-right">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-4">
                        <div class="card card-primary card-outline">
                            <div class="card-body box-profile">
                                <div class="text-center">
                                    {% if utilisateur.photoProfil %}
                                        <img class="profile-user-img img-fluid img-circle"
                                             src="{{ asset('uploads/photos/' ~ utilisateur.photoProfil) }}"
                                             alt="User profile picture">
                                    {% else %}
                                        <i class="fas fa-user-circle fa-10x text-secondary"></i>
                                    {% endif %}
                                </div>

                                <h3 class="profile-username text-center">{{ utilisateur.nomComplet }}</h3>
                                <p class="text-muted text-center">
                                    {% if utilisateur is instanceof('App\\Entity\\Admin') %}
                                        <span class="badge badge-danger badge-lg">
                                        <i class="fas fa-user-shield"></i> Administrateur
                                    </span>
                                    {% else %}
                                        <span class="badge badge-success badge-lg">
                                        <i class="fas fa-user"></i> Client
                                    </span>
                                    {% endif %}
                                </p>

                                <ul class="list-group list-group-unbordered mb-3">
                                    <li class="list-group-item">
                                        <b>ID</b> <a class="float-right">#{{ utilisateur.id }}</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Email</b> <a class="float-right">{{ utilisateur.email }}</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Téléphone</b> <a class="float-right">{{ utilisateur.telephone ?? 'N/A' }}</a>
                                    </li>
                                </ul>

                                {% if utilisateur.id != app.user.id %}
                                    <form method="post"
                                          action="{{ path('admin_utilisateur_delete', {'id': utilisateur.id}) }}"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ utilisateur.id) }}">
                                        <button type="submit" class="btn btn-danger btn-block">
                                            <i class="fas fa-trash"></i> Supprimer l'utilisateur
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Informations détaillées</h3>
                            </div>
                            <div class="card-body">
                                <strong><i class="fas fa-user mr-1"></i> Nom complet</strong>
                                <p class="text-muted">{{ utilisateur.prenom }} {{ utilisateur.nom }}</p>
                                <hr>

                                <strong><i class="fas fa-envelope mr-1"></i> Adresse email</strong>
                                <p class="text-muted">{{ utilisateur.email }}</p>
                                <hr>

                                <strong><i class="fas fa-phone mr-1"></i> Téléphone</strong>
                                <p class="text-muted">{{ utilisateur.telephone ?? 'Non renseigné' }}</p>
                                <hr>

                                <strong><i class="fas fa-map-marker-alt mr-1"></i> Adresse</strong>
                                <p class="text-muted">{{ utilisateur.adresse ?? 'Non renseignée' }}</p>
                                <hr>

                                <strong><i class="fas fa-shield-alt mr-1"></i> Rôles</strong>
                                <p class="text-muted">
                                    {% for role in utilisateur.roles %}
                                        <span class="badge badge-info">{{ role }}</span>
                                    {% endfor %}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
