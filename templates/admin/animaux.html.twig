{% extends 'layout/admin.html.twig' %}

{% block title %}Gestion des Animaux - Admin{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-paw"></i> Gestion des Animaux</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Animaux</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Liste de tous les animaux</h3>
                </div>
                <!-- /.card-header -->
                <div class="card-body">
                    <table id="table_animaux" class="table table-bordered table-striped">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Photo</th>
                            <th>Nom</th>
                            <th>Race</th>
                            <th>Propriétaire</th>
                            <th>Age</th>
                            <th>Sexe</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for animal in animaux %}
                            <tr>
                                <td>{{ animal.id }}</td>
                                <td>
                                    {% if animal.photo %}
                                        <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}" alt="{{ animal.nom }}" style="height: 50px; width: 50px; object-fit: cover; border-radius: 50%;">
                                    {% else %}
                                        <i class="fas fa-paw fa-2x text-muted"></i>
                                    {% endif %}
                                </td>
                                <td>{{ animal.nom }}</td>
                                <td>{{ animal.race }}</td>
                                <td>
                                    <a href="{{ path('admin_utilisateur_show', {'id': animal.proprietaire.id}) }}">
                                        {{ animal.proprietaire.nomComplet }}
                                    </a>
                                </td>
                                <td>{{ animal.age }}</td>
                                <td>{{ animal.sexe }}</td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_animal_show', {'id': animal.id}) }}" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_animal_edit', {'id': animal.id}) }}" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <!-- /.card-body -->
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    <!-- DataTables -->
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css') }}">
{% endblock %}

{% block javascripts %}
    <!-- DataTables  & Plugins -->
    <script src="{{ asset('adminlte/plugins/datatables/jquery.dataTables.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js') }}"></script>
    <script>
        $(function () {
            $("#table_animaux").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json"
                }
            }).buttons().container().appendTo('#table_animaux_wrapper .col-md-6:eq(0)');
        });
    </script>
{% endblock %}
