{% extends 'layout/admin.html.twig' %}

{% block title %}Gestion des Annonces - Admin{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-bullhorn"></i> Gestion des Annonces</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Annonces</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Liste de toutes les annonces</h3>
                    <div class="card-tools">
                        <span class="badge badge-success">{{ annonces|length }} annonces</span>
                    </div>
                </div>
                <!-- /.card-header -->
                <div class="card-body">
                    <table id="table_annonces" class="table table-bordered table-striped">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Type</th>
                            <th>Auteur</th>
                            <th>Date</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for annonce in annonces %}
                            <tr>
                                <td>{{ annonce.id }}</td>
                                <td>{{ annonce.titre }}</td>
                                <td>
                                    {% if annonce.type == 'adoption' %}
                                        <span class="badge badge-primary">Adoption</span>
                                    {% elseif annonce.type == 'garde' %}
                                        <span class="badge badge-info">Garde</span>
                                    {% else %}
                                        <span class="badge badge-secondary">{{ annonce.type }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <a href="{{ path('admin_utilisateur_show', {'id': annonce.auteur.id}) }}">
                                        {{ annonce.auteur.nomComplet }}
                                    </a>
                                </td>
                                <td>{{ annonce.datePublication|date('d/m/Y') }}</td>
                                <td>
                                    {% if annonce.statut == 'active' %}
                                        <span class="badge badge-success">Active</span>
                                    {% else %}
                                        <span class="badge badge-secondary">Clôturée</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a href="{{ path('app_annonce_show', {'id': annonce.id}) }}" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_annonce_edit', {'id': annonce.id}) }}" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <!-- /.card-body -->
            </div>
        </div>
    </section>
{% endblock %}

{% block stylesheets %}
    <!-- DataTables -->
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-responsive/css/responsive.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('adminlte/plugins/datatables-buttons/css/buttons.bootstrap4.min.css') }}">
{% endblock %}

{% block javascripts %}
    <!-- DataTables  & Plugins -->
    <script src="{{ asset('adminlte/plugins/datatables/jquery.dataTables.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-responsive/js/dataTables.responsive.min.js') }}"></script>
    <script src="{{ asset('adminlte/plugins/datatables-responsive/js/responsive.bootstrap4.min.js') }}"></script>
    <script>
        $(function () {
            $("#table_annonces").DataTable({
                "responsive": true, "lengthChange": false, "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json"
                },
                "order": [[ 4, "desc" ]] // Trier par date décroissante
            }).buttons().container().appendTo('#table_annonces_wrapper .col-md-6:eq(0)');
        });
    </script>
{% endblock %}
