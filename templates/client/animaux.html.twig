{% extends 'layout/client.html.twig' %}

{% block title %}Mes Animaux - PetNexus{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-paw"></i> Mes Animaux</h1>
                </div>
                <div class="col-sm-6">
                    <a href="{{ path('app_animal_new') }}" class="btn btn-primary float-right">
                        <i class="fas fa-plus"></i> Ajouter un animal
                    </a>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}

            {% if animaux|length > 0 %}
                <div class="row">
                    {% for animal in animaux %}
                        <div class="col-lg-4 col-md-6 mb-4">
                            <div class="card h-100">
                                {% if animal.photo %}
                                    <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}"
                                         class="card-img-top"
                                         alt="{{ animal.nom }}"
                                         style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                         style="height: 200px;">
                                        <i class="fas fa-paw fa-5x text-muted"></i>
                                    </div>
                                {% endif %}

                                <div class="card-body">
                                    <h5 class="card-title">{{ animal.nom }}</h5>
                                    <p class="card-text">
                                        <strong>Race :</strong> {{ animal.race }}<br>
                                        <strong>Âge :</strong> {{ animal.age }} an(s)<br>
                                        <strong>Sexe :</strong> 
                                        {% if animal.sexe == 'male' %}
                                            <span class="badge badge-info"><i class="fas fa-mars"></i> Mâle</span>
                                        {% else %}
                                            <span class="badge badge-pink"><i class="fas fa-venus"></i> Femelle</span>
                                        {% endif %}
                                    </p>
                                    {% if animal.description %}
                                        <p class="card-text text-muted">{{ animal.description|slice(0, 80) }}{% if animal.description|length > 80 %}...{% endif %}</p>
                                    {% endif %}
                                </div>

                                <div class="card-footer">
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_animal_show', {'id': animal.id}) }}"
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_animal_edit', {'id': animal.id}) }}"
                                           class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" action="{{ path('app_animal_delete', {'id': animal.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-paw fa-5x text-muted mb-4"></i>
                        <h4>Aucun animal enregistré</h4>
                        <p class="text-muted">Commencez par ajouter votre premier compagnon !</p>
                        <a href="{{ path('app_animal_new') }}" class="btn btn-primary btn-lg">
                            <i class="fas fa-plus"></i> Ajouter mon premier animal
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
