{% extends 'layout/client.html.twig' %}

{% block title %}Mes Annonces - PetNexus{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-bullhorn"></i> Mes Annonces</h1>
                </div>
                <div class="col-sm-6">
                    <a href="{{ path('app_annonce_new') }}" class="btn btn-success float-right">
                        <i class="fas fa-plus"></i> Créer une annonce
                    </a>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}

            {% if annonces|length > 0 %}
                <!-- Stats rapides -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="info-box bg-success">
                            <span class="info-box-icon"><i class="fas fa-check"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Annonces actives</span>
                                <span class="info-box-number">{{ annonces|filter(a => a.statut == 'active')|length }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box bg-secondary">
                            <span class="info-box-icon"><i class="fas fa-times"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Annonces clôturées</span>
                                <span class="info-box-number">{{ annonces|filter(a => a.statut == 'cloturee')|length }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-box bg-info">
                            <span class="info-box-icon"><i class="fas fa-list"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Total annonces</span>
                                <span class="info-box-number">{{ annonces|length }}</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    {% for annonce in annonces %}
                        <div class="col-lg-6 mb-4">
                            <div class="card h-100">
                                <div class="card-header bg-{{ annonce.statut == 'active' ? 'success' : 'secondary' }} text-white">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-light text-dark">
                                            {% if annonce.type == 'adoption' %}
                                                <i class="fas fa-heart"></i>
                                            {% elseif annonce.type == 'garde' %}
                                                <i class="fas fa-home"></i>
                                            {% elseif annonce.type == 'echange' %}
                                                <i class="fas fa-exchange-alt"></i>
                                            {% else %}
                                                <i class="fas fa-tag"></i>
                                            {% endif %}
                                            {{ annonce.type|capitalize }}
                                        </span>
                                        <span class="badge bg-{{ annonce.statut == 'active' ? 'warning' : 'dark' }}">
                                            {{ annonce.statut == 'active' ? 'Active' : 'Clôturée' }}
                                        </span>
                                    </div>
                                </div>

                                <div class="card-body">
                                    <h5 class="card-title">{{ annonce.titre }}</h5>
                                    <p class="card-text">{{ annonce.description|slice(0, 150) }}{% if annonce.description|length > 150 %}...{% endif %}</p>

                                    {% if annonce.animals|length > 0 %}
                                        <div class="mt-3">
                                            <h6><i class="fas fa-paw"></i> Animaux concernés :</h6>
                                            <div class="d-flex flex-wrap gap-1">
                                                {% for animal in annonce.animals %}
                                                    <span class="badge badge-info mr-1 mb-1">
                                                        {% if animal.photo %}
                                                            <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}" 
                                                                 style="width: 20px; height: 20px; border-radius: 50%; object-fit: cover;"
                                                                 alt="{{ animal.nom }}">
                                                        {% endif %}
                                                        {{ animal.nom }}
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}

                                    <div class="mt-3">
                                        <small class="text-muted">
                                            <i class="fas fa-calendar"></i>
                                            Publiée le {{ annonce.datePublication|date('d/m/Y à H:i') }}
                                        </small>
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_annonce_show', {'id': annonce.id}) }}"
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_annonce_edit', {'id': annonce.id}) }}"
                                           class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Modifier
                                        </a>
                                        <form method="post" action="{{ path('app_annonce_delete', {'id': annonce.id}) }}"
                                              class="d-inline"
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette annonce ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ annonce.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-bullhorn fa-5x text-muted mb-4"></i>
                        <h4>Aucune annonce créée</h4>
                        <p class="text-muted">Créez votre première annonce pour proposer vos animaux à l'adoption, à la garde ou à l'échange !</p>
                        <a href="{{ path('app_annonce_new') }}" class="btn btn-success btn-lg">
                            <i class="fas fa-plus"></i> Créer ma première annonce
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
