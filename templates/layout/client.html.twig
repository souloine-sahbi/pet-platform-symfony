{% extends 'base.html.twig' %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('client_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    {% if app.user.photoProfil %}
                        <img src="{{ asset('uploads/photos/' ~ app.user.photoProfil) }}" class="img-circle elevation-2" alt="User Image">
                    {% else %}
                        <div class="img-circle elevation-2 bg-white d-flex align-items-center justify-content-center" style="width: 33px; height: 33px;">
                            <i class="fas fa-user text-secondary"></i>
                        </div>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ path('profil_show') }}" class="d-block">{{ app.user.nomComplet }}</a>
                </div>
            </div>
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="{{ path('client_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'client_dashboard' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-home"></i>
                            <p>Accueil</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('client_animaux') }}" class="nav-link {{ app.request.get('_route') == 'client_animaux' or app.request.get('_route') starts with 'app_animal' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-paw"></i>
                            <p>Mes Animaux</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_annonce_public') }}" class="nav-link {{ app.request.get('_route') == 'app_annonce_public' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-search"></i>
                            <p>Toutes les Annonces</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('client_annonces') }}" class="nav-link {{ app.request.get('_route') == 'client_annonces' or app.request.get('_route') starts with 'app_annonce' and app.request.get('_route') != 'app_annonce_public' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-bullhorn"></i>
                            <p>Mes Annonces</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_demande_index') }}" class="nav-link {{ 'app_demande' in app.request.get('_route') or 'client_demandes' in app.request.get('_route') ? 'active' : '' }}">
                            <i class="nav-icon fas fa-clipboard-list"></i>
                            <p>Mes Demandes</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_message_index') }}" class="nav-link {{ 'app_message' in app.request.get('_route') or 'client_messages' in app.request.get('_route') ? 'active' : '' }}">
                            <i class="nav-icon fas fa-envelope"></i>
                            <p>Messages</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('evaluation_index') }}" class="nav-link {{ 'evaluation' in app.request.get('_route') ? 'active' : '' }}">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Mes Évaluations</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('profil_show') }}" class="nav-link {{ 'profil' in app.request.get('_route') ? 'active' : '' }}">
                            <i class="nav-icon fas fa-user-cog"></i>
                            <p>Mon Profil</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        {% block content %}{% endblock %}
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 <a href="#">PetNexus</a>.</strong>
        Tous droits réservés.
    </footer>
{% endblock %}
