{% extends 'base.html.twig' %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('admin_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus Admin</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    {% if app.user.photoProfil %}
                        <img src="{{ asset('uploads/photos/' ~ app.user.photoProfil) }}" class="img-circle elevation-2" alt="User Image">
                    {% else %}
                        <div class="img-circle elevation-2 bg-white d-flex align-items-center justify-content-center" style="width: 33px; height: 33px;">
                            <i class="fas fa-user-shield text-secondary"></i>
                        </div>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ path('admin_parametres') }}" class="d-block">{{ app.user.nomComplet }}</a>
                </div>
            </div>
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}" class="nav-link {{ app.request.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_utilisateur_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_utilisateur' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Utilisateurs</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_animaux') }}" class="nav-link {{ app.request.get('_route') == 'admin_animaux' or app.request.get('_route') starts with 'app_animal' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-paw"></i>
                            <p>Animaux</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_annonces') }}" class="nav-link {{ app.request.get('_route') == 'admin_annonces' or app.request.get('_route') starts with 'app_annonce' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-bullhorn"></i>
                            <p>Annonces</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('admin_messages') }}" class="nav-link {{ app.request.get('_route') == 'admin_messages' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-envelope"></i>
                            <p>Messages</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_evaluation_index') }}" class="nav-link {{ app.request.get('_route') starts with 'admin_evaluation' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_parametres') }}" class="nav-link {{ app.request.get('_route') == 'admin_parametres' ? 'active' : '' }}">
                            <i class="nav-icon fas fa-cogs"></i>
                            <p>Paramètres</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        {% block content %}{% endblock %}
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
