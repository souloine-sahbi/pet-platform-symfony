{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}Modifier l'évaluation{% endblock %}

{% block content %}
     <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-edit"></i> Modifier l'évaluation</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('evaluation_index') }}">Évaluations</a></li>
                        <li class="breadcrumb-item active">Modifier</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-warning">
                        <div class="card-header">
                            <h3 class="card-title">Modification de l'avis pour {{ evaluation.evalue.nomComplet }}</h3>
                        </div>
                        {{ form_start(form) }}
                        <div class="card-body">
                            <div class="form-group text-center">
                                <label>Note globale</label>
                                <div class="rating-css">
                                    {{ form_widget(form.note, {'attr': {'class': 'form-control', 'style': 'display:block; width: 100%;'}}) }}
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Votre commentaire</label>
                                {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                                {{ form_errors(form.commentaire) }}
                            </div>
                        </div>
                        <div class="card-footer">
                             <button type="submit" class="btn btn-warning float-right">
                                <i class="fas fa-save"></i> Enregistrer les modifications
                            </button>
                            <a href="{{ path('evaluation_index') }}" class="btn btn-default">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
