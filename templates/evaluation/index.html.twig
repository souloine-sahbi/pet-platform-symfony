{% extends 'base.html.twig' %}

{% block title %}Mes Évaluations{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('client_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    {% if app.user.photoProfil %}
                        <img src="{{ asset('uploads/photos/' ~ app.user.photoProfil) }}" class="img-circle elevation-2" alt="User Image">
                    {% else %}
                        <i class="fas fa-user-circle fa-2x text-white"></i>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ path('profil_show') }}" class="d-block">{{ app.user.nomComplet }}</a>
                </div>
            </div>
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                    <li class="nav-item">
                        <a href="{{ path('client_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-home"></i>
                            <p>Accueil</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('evaluation_index') }}" class="nav-link active">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Mes Évaluations</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('profil_show') }}" class="nav-link">
                            <i class="nav-icon fas fa-user-cog"></i>
                            <p>Mon Profil</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Mes Évaluations</h1>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                {% endfor %}

                <div class="row">
                    <div class="col-lg-4">
                        <div class="info-box bg-gradient-info">
                            <span class="info-box-icon"><i class="fas fa-star"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Nombre d'évaluations</span>
                                <span class="info-box-number">{{ total }}</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="info-box bg-gradient-warning">
                            <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Moyenne</span>
                                <span class="info-box-number">{{ moyenne|number_format(2) }} / 5</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="info-box bg-gradient-success">
                            <span class="info-box-icon"><i class="fas fa-trophy"></i></span>
                            <div class="info-box-content">
                                <span class="info-box-text">Réputation</span>
                                <span class="info-box-number">
                                {% if moyenne >= 4.5 %}Excellente
                                {% elseif moyenne >= 3.5 %}Très bonne
                                {% elseif moyenne >= 2.5 %}Bonne
                                {% else %}À améliorer{% endif %}
                            </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Évaluations reçues</h3>
                    </div>
                    <div class="card-body">
                        {% if evaluations is empty %}
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> Vous n'avez pas encore reçu d'évaluations.
                            </div>
                        {% else %}
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                    <tr>
                                        <th>De</th>
                                        <th>Note</th>
                                        <th>Commentaire</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    {% for evaluation in evaluations %}
                                        <tr>
                                            <td>{{ evaluation.evaluateur.nomComplet }}</td>
                                            <td>
                                                {% for i in 1..5 %}
                                                    {% if i <= evaluation.note %}
                                                        <i class="fas fa-star text-warning"></i>
                                                    {% else %}
                                                        <i class="far fa-star text-warning"></i>
                                                    {% endif %}
                                                {% endfor %}
                                                ({{ evaluation.note }}/5)
                                            </td>
                                            <td>{{ evaluation.commentaire|default('Aucun commentaire') }}</td>
                                            <td>{{ evaluation.dateEvaluation|date('d/m/Y H:i') }}</td>
                                            <td>
                                                <a href="{{ path('evaluation_show', {'id': evaluation.id}) }}" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
