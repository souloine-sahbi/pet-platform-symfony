{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}Mes Évaluations{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-star"></i> Mes Évaluations</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Évaluations</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show">
                    {{ message }}
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endfor %}

            <div class="row">
                <div class="col-lg-4 col-6">
                    <div class="small-box bg-info">
                        <div class="inner">
                            <h3>{{ total }}</h3>
                            <p>Évaluations reçues</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-star"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-6">
                    <div class="small-box bg-warning">
                        <div class="inner">
                            <h3>{{ moyenne|number_format(1) }}<sup style="font-size: 20px">/5</sup></h3>
                            <p>Moyenne générale</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-12">
                     <div class="small-box bg-success">
                        <div class="inner">
                            <h3>
                                {% if moyenne >= 4.5 %}Excellente
                                {% elseif moyenne >= 3.5 %}Très bonne
                                {% elseif moyenne >= 2.5 %}Bonne
                                {% else %}Moyenne{% endif %}
                            </h3>
                            <p>Réputation</p>
                        </div>
                        <div class="icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section : Utilisateurs à évaluer -->
            <div class="card card-success card-outline mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-edit"></i> Utilisateurs à évaluer
                    </h3>
                </div>
                <div class="card-body p-0">
                    {% if usersToEvaluate is defined and usersToEvaluate|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th style="width: 150px;" class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for user in usersToEvaluate %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                {% if user.photoProfil %}
                                                    <img src="{{ asset('uploads/photos/' ~ user.photoProfil) }}" class="img-circle mr-3" style="width: 40px; height: 40px; object-fit: cover;" alt="Avatar">
                                                {% else %}
                                                     <div class="img-circle bg-light d-flex align-items-center justify-content-center mr-3" style="width: 40px; height: 40px;">
                                                        <i class="fas fa-user text-secondary"></i>
                                                    </div>
                                                {% endif %}
                                                <span class="font-weight-bold">{{ user.nomComplet }}</span>
                                            </div>
                                        </td>
                                        <td class="text-right">
                                            <a href="{{ path('evaluation_new', {'id': user.id}) }}" class="btn btn-success btn-sm">
                                                <i class="fas fa-star"></i> Noter (sur 5)
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-check-circle fa-2x mb-2"></i>
                            <p class="mb-0">Vous n'avez aucun utilisateur en attente d'évaluation.</p>
                            <small>(Seuls les utilisateurs avec qui vous avez une demande acceptée apparaissent ici)</small>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">Historique des évaluations reçues</h3>
                </div>
                <div class="card-body">
                    {% if evaluations is empty %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Vous n'avez pas encore reçu d'évaluations.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                <tr>
                                    <th>Auteur</th>
                                    <th>Note</th>
                                    <th>Commentaire</th>
                                    <th>Date</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for evaluation in evaluations %}
                                    <tr>
                                        <td>
                                            <div class="user-block">
                                                {% if evaluation.evaluateur.photoProfil %}
                                                    <img class="img-circle img-bordered-sm" src="{{ asset('uploads/photos/' ~ evaluation.evaluateur.photoProfil) }}" alt="User Image">
                                                {% else %}
                                                     <i class="fas fa-user-circle fa-2x text-muted"></i>
                                                {% endif %}
                                                <span class="username">
                                                    {{ evaluation.evaluateur.nomComplet }}
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-warning">
                                                {% for i in 1..5 %}
                                                    {% if i <= evaluation.note %}
                                                        <i class="fas fa-star"></i>
                                                    {% else %}
                                                        <i class="far fa-star"></i>
                                                    {% endif %}
                                                {% endfor %}
                                                <span class="text-dark small ml-1">({{ evaluation.note }}/5)</span>
                                            </div>
                                        </td>
                                        <td>
                                            <p class="text-muted mb-0">
                                                {% if evaluation.commentaire %}
                                                    "{{ evaluation.commentaire }}"
                                                {% else %}
                                                    <em>Aucun commentaire</em>
                                                {% endif %}
                                            </p>
                                        </td>
                                        <td>{{ evaluation.dateEvaluation|date('d/m/Y') }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
