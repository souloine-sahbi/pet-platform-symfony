{% extends 'base.html.twig' %}

{% block title %}Évaluer {{ client.nomComplet }}{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('client_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus</span>
        </a>
        <div class="sidebar">
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column">
                    <li class="nav-item">
                        <a href="{{ path('client_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-home"></i>
                            <p>Accueil</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('evaluation_index') }}" class="nav-link active">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <h1 class="m-0">Évaluer {{ client.nomComplet }}</h1>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card card-primary">
                            <div class="card-header">
                                <h3 class="card-title">Nouvelle Évaluation</h3>
                            </div>
                            {{ form_start(form) }}
                            <div class="card-body">
                                {{ form_row(form.note) }}
                                {{ form_row(form.commentaire) }}
                            </div>
                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Enregistrer l'évaluation
                                </button>
                                <a href="{{ path('evaluation_index') }}" class="btn btn-secondary">
                                    <i class="fas fa-times"></i> Annuler
                                </a>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-widget widget-user">
                            <div class="widget-user-header bg-info">
                                <h3 class="widget-user-username">{{ client.nomComplet }}</h3>
                                <h5 class="widget-user-desc">Client PetNexus</h5>
                            </div>
                            <div class="widget-user-image">
                                {% if client.photoProfil %}
                                    <img class="img-circle elevation-2" src="{{ asset('uploads/photos/' ~ client.photoProfil) }}" alt="User Avatar">
                                {% else %}
                                    <i class="fas fa-user-circle fa-5x"></i>
                                {% endif %}
                            </div>
                            <div class="card-footer">
                                <div class="description-block">
                                    <h5 class="description-header">{{ client.email }}</h5>
                                    <span class="description-text">EMAIL</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
