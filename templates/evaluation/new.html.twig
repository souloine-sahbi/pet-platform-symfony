{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}Laisser une évaluation{% endblock %}

{% block content %}
     <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-star-half-alt"></i> Laisser une évaluation</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('evaluation_index') }}">Évaluations</a></li>
                        <li class="breadcrumb-item active">Nouvelle</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-6">
                     <div class="card card-widget widget-user">
                        <div class="widget-user-header bg-info">
                            <h3 class="widget-user-username">{{ client.nomComplet }}</h3>
                            <h5 class="widget-user-desc">Destinataire de l'évaluation</h5>
                        </div>
                        <div class="widget-user-image">
                            {% if client.photoProfil %}
                                <img class="img-circle elevation-2" src="{{ asset('uploads/photos/' ~ client.photoProfil) }}" alt="User Avatar">
                            {% else %}
                                <div class="img-circle elevation-2 bg-white d-flex align-items-center justify-content-center" style="width: 90px; height: 90px;">
                                    <i class="fas fa-user fa-3x text-secondary"></i>
                                </div>
                            {% endif %}
                        </div>
                        <div class="card-footer p-0">
                            <!-- Espace pour séparer l'avatar du contenu -->
                            <div class="d-flex justify-content-center pt-5 pb-3">
                                <span class="text-muted">Merci de partager votre expérience.</span>
                            </div>
                        </div>
                    </div>

                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Votre avis nous intéresse</h3>
                        </div>
                        {{ form_start(form) }}
                        <div class="card-body">
                            <div class="callout callout-warning">
                                <h5><i class="fas fa-exclamation-triangle"></i> Important</h5>
                                <p>Les évaluations doivent être honnêtes et respectueuses. Seules les personnes ayant eu une interaction réelle (demande acceptée) peuvent laisser un avis.</p>
                            </div>

                            <div class="form-group text-center">
                                <label>Note globale</label>
                                <div class="rating-css">
                                    {{ form_widget(form.note, {'attr': {'class': 'form-control', 'style': 'display:block; width: 100%;'}}) }}
                                </div>
                                <small class="text-muted">Sélectionnez une note de 1 à 5</small>
                            </div>

                            <div class="form-group">
                                <label>Votre commentaire</label>
                                {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Racontez votre expérience...'}}) }}
                                {{ form_errors(form.commentaire) }}
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success float-right">
                                <i class="fas fa-check"></i> Publier l'avis
                            </button>
                            <a href="{{ path('client_dashboard') }}" class="btn btn-default">
                                <i class="fas fa-times"></i> Annuler
                            </a>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
