{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}

{% block title %}Détails de l'évaluation{% endblock %}

{% block content %}
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0"><i class="fas fa-star"></i> Détails de l'évaluation</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="{{ path('client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('evaluation_index') }}">Évaluations</a></li>
                        <li class="breadcrumb-item active">Détails</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card card-widget widget-user-2">
                         <div class="widget-user-header bg-warning">
                            <div class="widget-user-image">
                                {% if evaluation.evaluateur.photoProfil %}
                                    <img class="img-circle elevation-2" src="{{ asset('uploads/photos/' ~ evaluation.evaluateur.photoProfil) }}" alt="User Avatar">
                                {% else %}
                                     <div class="img-circle elevation-2 bg-white d-flex align-items-center justify-content-center" style="width: 65px; height: 65px;">
                                        <i class="fas fa-user text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <h3 class="widget-user-username">{{ evaluation.evaluateur.nomComplet }}</h3>
                            <h5 class="widget-user-desc">Évaluateur</h5>
                        </div>
                        <div class="card-footer p-0">
                            <div class="p-4">
                                <div class="text-center mb-4">
                                     <h1 class="display-4 text-warning">
                                        {{ evaluation.note }}<small class="text-muted" style="font-size: 0.5em;">/5</small>
                                    </h1>
                                    <div class="rating-star-display" style="font-size: 1.5em; color: #ffc107;">
                                        {% for i in 1..5 %}
                                            {% if i <= evaluation.note %}
                                                <i class="fas fa-star"></i>
                                            {% else %}
                                                <i class="far fa-star"></i>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <p class="text-muted mt-2">Évalué le {{ evaluation.dateEvaluation|date('d/m/Y à H:i') }}</p>
                                </div>

                                <div class="callout callout-info">
                                    <h5>Commentaire :</h5>
                                    <p class="font-italic">
                                        {% if evaluation.commentaire %}
                                            <i class="fas fa-quote-left mr-2 text-muted"></i>
                                            {{ evaluation.commentaire }}
                                            <i class="fas fa-quote-right ml-2 text-muted"></i>
                                        {% else %}
                                            <span class="text-muted">Aucun commentaire laissé.</span>
                                        {% endif %}
                                    </p>
                                </div>

                                <div class="mt-4 d-flex justify-content-between">
                                    <a href="{{ path('evaluation_index') }}" class="btn btn-default">
                                        <i class="fas fa-arrow-left"></i> Retour
                                    </a>

                                    {% if app.user == evaluation.evaluateur or is_granted('ROLE_ADMIN') %}
                                         <div>
                                            <a href="{{ path('evaluation_edit', {'id': evaluation.id}) }}" class="btn btn-warning">
                                                <i class="fas fa-edit"></i> Modifier
                                            </a>
                                            <form method="post" action="{{ path('evaluation_delete', {'id': evaluation.id}) }}" class="d-inline ml-1" onsubmit="return confirm('Supprimer cette évaluation ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evaluation.id) }}">
                                                <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
