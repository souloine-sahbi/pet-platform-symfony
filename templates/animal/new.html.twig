{% extends 'base.html.twig' %}

{% block title %}Ajouter un animal{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">
            <i class="fas fa-plus-circle"></i> Ajouter un animal
        </h1>

        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Informations de l'animal</h2>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.race) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        {{ form_row(form.age) }}
                    </div>
                    <div class="col-md-3">
                        {{ form_row(form.sexe) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.photo) }}
                    </div>
                </div>

                {{ form_row(form.description) }}

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_animal_index') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
