{% extends 'base.html.twig' %}

{% block title %}{{ animal.nom }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8">
                <h1 class="mb-4">
                    <i class="fas fa-paw"></i> {{ animal.nom }}
                </h1>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                {% if animal.photo %}
                                    <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}"
                                         class="img-fluid rounded"
                                         alt="{{ animal.nom }}">
                                {% else %}
                                    <div class="bg-light rounded p-5 text-center">
                                        <i class="fas fa-paw fa-5x text-muted"></i>
                                        <p class="mt-2 text-muted">Pas de photo</p>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="col-md-8">
                                <h3>Informations</h3>
                                <table class="table">
                                    <tr>
                                        <th>Nom :</th>
                                        <td>{{ animal.nom }}</td>
                                    </tr>
                                    <tr>
                                        <th>Race :</th>
                                        <td>{{ animal.race }}</td>
                                    </tr>
                                    <tr>
                                        <th>Âge :</th>
                                        <td>{{ animal.age }} an(s)</td>
                                    </tr>
                                    <tr>
                                        <th>Sexe :</th>
                                        <td>{{ animal.sexe == 'male' ? 'Mâle' : 'Femelle' }}</td>
                                    </tr>
                                    <tr>
                                        <th>Propriétaire :</th>
                                        <td>{{ animal.proprietaire.nomComplet }}</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        {% if animal.description %}
                            <div class="mt-4">
                                <h3>Description</h3>
                                <p>{{ animal.description }}</p>
                            </div>
                        {% endif %}
                    </div>

                    <div class="card-footer">
                        <a href="{{ path('app_animal_edit', {'id': animal.id}) }}"
                           class="btn btn-warning">
                            <i class="fas fa-edit"></i> Modifier
                        </a>

                        <form method="post" action="{{ path('app_animal_delete', {'id': animal.id}) }}"
                              class="d-inline"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        </form>

                        <a href="{{ path('app_animal_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
