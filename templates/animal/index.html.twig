{% extends 'base.html.twig' %}

{% block title %}Mes Animaux{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">
            <i class="fas fa-paw"></i> Mes Animaux
            <a href="{{ path('app_animal_new') }}" class="btn btn-primary float-end">
                <i class="fas fa-plus"></i> Ajouter un animal
            </a>
        </h1>

        {% if animals|length > 0 %}
            <div class="row">
                {% for animal in animals %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            {% if animal.photo %}
                                <img src="{{ asset('uploads/animaux/' ~ animal.photo) }}"
                                     class="card-img-top"
                                     alt="{{ animal.nom }}"
                                     style="height: 200px; object-fit: cover;">
                            {% else %}
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                                     style="height: 200px;">
                                    <i class="fas fa-paw fa-5x text-muted"></i>
                                </div>
                            {% endif %}

                            <div class="card-body">
                                <h5 class="card-title">{{ animal.nom }}</h5>
                                <p class="card-text">
                                    <strong>Race :</strong> {{ animal.race }}<br>
                                    <strong>Âge :</strong> {{ animal.age }} an(s)<br>
                                    <strong>Sexe :</strong> {{ animal.sexe == 'male' ? 'Mâle' : 'Femelle' }}
                                </p>
                                {% if animal.description %}
                                    <p class="card-text">{{ animal.description|slice(0, 100) }}...</p>
                                {% endif %}
                            </div>

                            <div class="card-footer">
                                <a href="{{ path('app_animal_show', {'id': animal.id}) }}"
                                   class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                <a href="{{ path('app_animal_edit', {'id': animal.id}) }}"
                                   class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Modifier
                                </a>

                                <form method="post" action="{{ path('app_animal_delete', {'id': animal.id}) }}"
                                      class="d-inline"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Vous n'avez pas encore d'animaux enregistrés.
                <a href="{{ path('app_animal_new') }}" class="alert-link">Ajoutez votre premier animal !</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
