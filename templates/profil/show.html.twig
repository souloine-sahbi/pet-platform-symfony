{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>
        <ul class="navbar-nav ml-auto">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Déconnexion
                </a>
            </li>
        </ul>
    </nav>

    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a href="{{ path('client_dashboard') }}" class="brand-link">
            <i class="fas fa-paw brand-image"></i>
            <span class="brand-text font-weight-light">PetNexus</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    {% if user.photoProfil %}
                        <img src="{{ asset('uploads/photos/' ~ user.photoProfil) }}" class="img-circle elevation-2" alt="User Image">
                    {% else %}
                        <i class="fas fa-user-circle fa-2x text-white"></i>
                    {% endif %}
                </div>
                <div class="info">
                    <a href="{{ path('profil_show') }}" class="d-block">{{ user.nomComplet }}</a>
                </div>
            </div>
            <nav class="mt-2">
                <ul class="nav nav-pills nav-sidebar flex-column">
                    <li class="nav-item">
                        <a href="{{ path('client_dashboard') }}" class="nav-link">
                            <i class="nav-icon fas fa-home"></i>
                            <p>Accueil</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('evaluation_index') }}" class="nav-link">
                            <i class="nav-icon fas fa-star"></i>
                            <p>Évaluations</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('profil_show') }}" class="nav-link active">
                            <i class="nav-icon fas fa-user-cog"></i>
                            <p>Mon Profil</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <div class="content-wrapper">
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Mon Profil</h1>
                    </div>
                    <div class="col-sm-6">
                        <a href="{{ path('profil_edit') }}" class="btn btn-primary float-right">
                            <i class="fas fa-edit"></i> Modifier mon profil
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                {% endfor %}

                <div class="row">
                    <div class="col-md-4">
                        <div class="card card-primary card-outline">
                            <div class="card-body box-profile">
                                <div class="text-center">
                                    {% if user.photoProfil %}
                                        <img class="profile-user-img img-fluid img-circle"
                                             src="{{ asset('uploads/photos/' ~ user.photoProfil) }}"
                                             alt="User profile picture">
                                    {% else %}
                                        <i class="fas fa-user-circle fa-10x text-secondary"></i>
                                    {% endif %}
                                </div>

                                <h3 class="profile-username text-center">{{ user.nomComplet }}</h3>
                                <p class="text-muted text-center">
                                    {% if is_granted('ROLE_ADMIN') %}
                                        Administrateur
                                    {% else %}
                                        Client
                                    {% endif %}
                                </p>

                                <ul class="list-group list-group-unbordered mb-3">
                                    <li class="list-group-item">
                                        <b>Email</b> <a class="float-right">{{ user.email }}</a>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Téléphone</b> <a class="float-right">{{ user.telephone ?? 'Non renseigné' }}</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Informations personnelles</h3>
                            </div>
                            <div class="card-body">
                                <strong><i class="fas fa-user mr-1"></i> Nom complet</strong>
                                <p class="text-muted">{{ user.nomComplet }}</p>
                                <hr>

                                <strong><i class="fas fa-envelope mr-1"></i> Email</strong>
                                <p class="text-muted">{{ user.email }}</p>
                                <hr>

                                <strong><i class="fas fa-phone mr-1"></i> Téléphone</strong>
                                <p class="text-muted">{{ user.telephone ?? 'Non renseigné' }}</p>
                                <hr>

                                <strong><i class="fas fa-map-marker-alt mr-1"></i> Adresse</strong>
                                <p class="text-muted">{{ user.adresse ?? 'Non renseignée' }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <footer class="main-footer">
        <strong>Copyright &copy; 2024 PetNexus.</strong> Tous droits réservés.
    </footer>
{% endblock %}
