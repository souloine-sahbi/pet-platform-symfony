{% extends 'base.html.twig' %}

{% block title %}Modifier la demande{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">
            <i class="fas fa-edit"></i> Modifier la demande
        </h1>

        <div class="card">
            <div class="card-header">
                <h2 class="h5 mb-0">Modifier votre demande</h2>
            </div>

            <div class="card-body">
                <!-- Informations sur l'annonce concernée -->
                {% if demande.annonce %}
                    <div class="alert alert-info mb-4">
                        <h5 class="alert-heading">
                            <i class="fas fa-bullhorn"></i> Annonce concernée
                        </h5>
                        <div class="row">
                            <div class="col-md-8">
                                <p class="mb-1"><strong>Titre :</strong> {{ demande.annonce.titre }}</p>
                                <p class="mb-1"><strong>Type :</strong> {{ demande.annonce.type|capitalize }}</p>
                                <p class="mb-1"><strong>Auteur :</strong> {{ demande.annonce.auteur.nomComplet }}</p>
                            </div>
                            <div class="col-md-4 text-end">
                                <a href="{{ path('app_annonce_show', {'id': demande.annonce.id}) }}"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="fas fa-eye"></i> Voir l'annonce
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <!-- Statut actuel de la demande -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Statut actuel</h6>
                            </div>
                            <div class="card-body">
                            <span class="badge bg-{{
                            demande.statut == 'en_attente' ? 'warning' :
                            (demande.statut == 'accepte' ? 'success' : 'danger')
                            }} fs-6">
                                {{ demande.statut|replace({'_': ' '})|title }}
                            </span>
                                <p class="mt-2 mb-0 text-muted small">
                                    <i class="fas fa-calendar"></i>
                                    Envoyée le {{ demande.dateEnvoi|date('d/m/Y à H:i') }}
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header bg-light">
                                <h6 class="mb-0">Destinataire</h6>
                            </div>
                            <div class="card-body">
                                <p class="mb-1">
                                    <i class="fas fa-user"></i>
                                    <strong>{{ demande.destinataire.nomComplet }}</strong>
                                </p>
                                <p class="mb-0 text-muted small">
                                    <i class="fas fa-envelope"></i> {{ demande.destinataire.email }}
                                </p>
                                {% if demande.destinataire.telephone %}
                                    <p class="mb-0 text-muted small">
                                        <i class="fas fa-phone"></i> {{ demande.destinataire.telephone }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Formulaire de modification -->
                {{ form_start(form) }}
                <div class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-comment-dots"></i> Votre message
                    </h5>
                    {{ form_row(form.message, {
                        'label': false,
                        'attr': {
                            'class': 'form-control',
                            'rows': 8,
                            'placeholder': 'Modifiez votre message ici...'
                        }
                    }) }}
                </div>

                <!-- Section statut (visible seulement pour admin ou destinataire) -->
                {% if is_granted('ROLE_ADMIN') or app.user.id == demande.destinataire.id %}
                    <div class="mb-4">
                        <h5 class="mb-3">
                            <i class="fas fa-cogs"></i> Gestion de la demande
                        </h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Modifier le statut</label>
                                    <select name="statut" class="form-select">
                                        <option value="en_attente" {{ demande.statut == 'en_attente' ? 'selected' : '' }}>
                                            En attente
                                        </option>
                                        <option value="accepte" {{ demande.statut == 'accepte' ? 'selected' : '' }}>
                                            Acceptée
                                        </option>
                                        <option value="refuse" {{ demande.statut == 'refuse' ? 'selected' : '' }}>
                                            Refusée
                                        </option>
                                    </select>
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle"></i>
                                        Seul le destinataire de la demande peut modifier le statut.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <a href="{{
                        app.user.id == demande.demandeur.id ?
                        path('client_demandes') :
                        path('admin_demandes')
                        }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour à la liste
                        </a>
                    </div>

                    <div class="btn-group">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save"></i> Enregistrer les modifications
                        </button>

                        {% if app.user.id == demande.demandeur.id %}
                            <!-- Le demandeur peut supprimer sa demande -->
                            <button type="button"
                                    class="btn btn-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        {% endif %}
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <!-- Modal de suppression -->
        {% if app.user.id == demande.demandeur.id %}
            <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title" id="deleteModalLabel">
                                <i class="fas fa-exclamation-triangle"></i> Confirmer la suppression
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="lead">Êtes-vous sûr de vouloir supprimer cette demande ?</p>
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-circle"></i>
                                Cette action est irréversible. La demande sera définitivement supprimée.
                            </div>

                            <div class="card">
                                <div class="card-body">
                                    <p><strong>Annonce :</strong> {{ demande.annonce.titre }}</p>
                                    <p><strong>Destinataire :</strong> {{ demande.destinataire.nomComplet }}</p>
                                    <p><strong>Date :</strong> {{ demande.dateEnvoi|date('d/m/Y H:i') }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="fas fa-times"></i> Annuler
                            </button>
                            <form method="post" action="{{ path('app_demande_delete', {'id': demande.id}) }}" class="d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ demande.id) }}">
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash"></i> Supprimer définitivement
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>

    {% block javascripts %}
        {{ parent() }}
        <script>
            // Validation du formulaire
            document.querySelector('form').addEventListener('submit', function(e) {
                const message = document.querySelector('#demande_message').value;
                if (message.trim().length < 10) {
                    e.preventDefault();
                    alert('Le message doit contenir au moins 10 caractères.');
                    return false;
                }
            });

            // Changement dynamique de couleur du badge statut
            const statutSelect = document.querySelector('select[name="statut"]');
            if (statutSelect) {
                const updateBadgeColor = () => {
                    const badge = document.querySelector('.badge.bg-warning, .badge.bg-success, .badge.bg-danger');
                    if (badge) {
                        const colors = {
                            'en_attente': 'warning',
                            'accepte': 'success',
                            'refuse': 'danger'
                        };
                        const newColor = colors[statutSelect.value] || 'secondary';
                        badge.className = `badge bg-${newColor} fs-6`;
                        badge.textContent = statutSelect.options[statutSelect.selectedIndex].text;
                    }
                };

                statutSelect.addEventListener('change', updateBadgeColor);
            }
        </script>
    {% endblock %}
{% endblock %}
