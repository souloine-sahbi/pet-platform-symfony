{% extends is_granted('ROLE_ADMIN') ? 'layout/admin.html.twig' : 'layout/client.html.twig' %}
{% block title %}Gestion des Demandes - PetNexus{% endblock %}

{% block content %}
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">Gestion des Demandes</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_dashboard' : 'client_dashboard') }}">Accueil</a></li>
                            <li class="breadcrumb-item active">Demandes</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <section class="content">
            <div class="container-fluid">
                {% if isAdmin %}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fas fa-list"></i>
                                Toutes les Demandes
                            </h3>
                        </div>
                        <div class="card-body">
                           <div class="table-responsive">
                                <table class="table table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>De</th>
                                            <th>Pour</th>
                                            <th>Statut</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for demande in demandes %}
                                        <tr>
                                            <td>{{ demande.id }}</td>
                                            <td>{{ demande.dateEnvoi|date('d/m/Y H:i') }}</td>
                                            <td>{{ demande.demandeur.nomComplet }}</td>
                                            <td>{{ demande.destinataire.nomComplet }}</td>
                                            <td>
                                                 <span class="badge badge-{{ demande.statut == 'en_attente' ? 'warning' : (demande.statut == 'acceptee' ? 'success' : 'danger') }}">
                                                    {{ demande.statut }}
                                                </span>
                                            </td>
                                            <td>
                                                <a href="{{ path('app_demande_show', {'id': demande.id}) }}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                                                <form method="post" action="{{ path('app_demande_delete', {'id': demande.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ demande.id) }}">
                                                    <button class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="6" class="text-center">Aucune demande</td></tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                {% else %}
                    {# Layout Client #}
                     <div class="row">
                        <!-- Demandes Reçues -->
                        <div class="col-lg-6">
                            <div class="card card-warning">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-inbox"></i> Demandes Reçues
                                        {% if demandesRecues|length > 0 %}
                                            <span class="badge badge-light ml-2">{{ demandesRecues|length }}</span>
                                        {% endif %}
                                    </h3>
                                </div>
                                <div class="card-body">
                                    {% if demandesRecues|length > 0 %}
                                        {% for demande in demandesRecues %}
                                            <div class="callout callout-{{ demande.statut == 'en_attente' ? 'warning' : (demande.statut == 'acceptee' ? 'success' : 'danger') }}">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h5>{{ demande.demandeur.nomComplet }}</h5>
                                                        <p class="mb-1">
                                                            {% if demande.annonce %}
                                                                <strong>Annonce :</strong> {{ demande.annonce.titre }}
                                                            {% endif %}
                                                        </p>
                                                        <small class="text-muted"><i class="fas fa-calendar"></i> {{ demande.dateEnvoi|date('d/m/Y H:i') }}</small>
                                                    </div>
                                                    <div>
                                                        <span class="badge badge-{{ demande.statut == 'en_attente' ? 'warning' : (demande.statut == 'acceptee' ? 'success' : 'danger') }}">
                                                            {{ demande.statut|replace({'_': ' '})|title }}
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="mt-2">
                                                    <a href="{{ path('app_demande_show', {'id': demande.id}) }}" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> Voir</a>
                                                    {% if demande.statut == 'en_attente' %}
                                                        <form method="post" action="{{ path('app_demande_accept', {'id': demande.id}) }}" class="d-inline">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ demande.id) }}">
                                                            <button class="btn btn-sm btn-success"><i class="fas fa-check"></i></button>
                                                        </form>
                                                        <form method="post" action="{{ path('app_demande_refuse', {'id': demande.id}) }}" class="d-inline">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('refuse' ~ demande.id) }}">
                                                            <button class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
                                                        </form>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-4 text-muted">Aucune demande reçue</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <!-- Demandes Envoyées -->
                        <div class="col-lg-6">
                            <div class="card card-info">
                                <div class="card-header">
                                    <h3 class="card-title">
                                        <i class="fas fa-paper-plane"></i> Demandes Envoyées
                                        {% if demandesEnvoyees|length > 0 %}
                                            <span class="badge badge-light ml-2">{{ demandesEnvoyees|length }}</span>
                                        {% endif %}
                                    </h3>
                                </div>
                                <div class="card-body">
                                    {% if demandesEnvoyees|length > 0 %}
                                        {% for demande in demandesEnvoyees %}
                                            <div class="callout callout-{{ demande.statut == 'en_attente' ? 'info' : (demande.statut == 'acceptee' ? 'success' : 'danger') }}">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <div>
                                                        <h5>À : {{ demande.destinataire.nomComplet }}</h5>
                                                        <p class="mb-1">
                                                            {% if demande.annonce %}
                                                                <strong>Annonce :</strong> {{ demande.annonce.titre }}
                                                            {% endif %}
                                                        </p>
                                                        <small class="text-muted"><i class="fas fa-calendar"></i> {{ demande.dateEnvoi|date('d/m/Y H:i') }}</small>
                                                    </div>
                                                    <div>
                                                        <span class="badge badge-{{ demande.statut == 'en_attente' ? 'info' : (demande.statut == 'acceptee' ? 'success' : 'danger') }}">
                                                            {{ demande.statut|replace({'_': ' '})|title }}
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="mt-2">
                                                    <a href="{{ path('app_demande_show', {'id': demande.id}) }}" class="btn btn-sm btn-info"><i class="fas fa-eye"></i> Voir</a>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="text-center py-4 text-muted">Aucune demande envoyée</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const statutFilter = document.getElementById('statutFilter');
            const typeFilter = document.getElementById('typeDemandeFilter');

            function filterTable() {
                const statutValue = statutFilter.value;
                const typeValue = typeFilter.value;

                document.querySelectorAll('tbody tr').forEach(row => {
                    let show = true;

                    // Filtre par statut
                    if (statutValue && row.dataset.statut !== statutValue) {
                        show = false;
                    }

                    // Filtre par type
                    if (typeValue) {
                        if (typeValue === 'envoyees' && row.dataset.type !== 'envoyee') {
                            show = false;
                        }
                        if (typeValue === 'recues' && row.dataset.type !== 'recue') {
                            show = false;
                        }
                    }

                    row.style.display = show ? '' : 'none';
                });
            }

            statutFilter.addEventListener('change', filterTable);
            typeFilter.addEventListener('change', filterTable);
        });
    </script>
{% endblock %}